{
  "name": "Azure Development Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": true,
      "terragrunt": false
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  "postCreateCommand": "pwsh -Command 'Install-Module -Name Az -Repository PSGallery -Force -AllowClobber -Scope CurrentUser'",

  "mounts": [
    "source=${localEnv:USERPROFILE}/.azure,target=/home/vscode/.azure,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-azurecli",
        "ms-azuretools.vscode-azureterraform",
        "ms-python.python",
        "ms-vscode.powershell",
        "hashicorp.terraform"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  },

  "remoteUser": "vscode"
}
